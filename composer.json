{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "santosvilanculos/cuirass",
    "type": "project",
    "description": "Tabler based Laravel starter kit",
    "homepage": "https://github.com/SantosVilanculos/cuirass",
    "keywords": [
        "laravel",
        "tabler"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Santos Vilanculos",
            "email": "santosvilanculos@yahoo.com",
            "homepage": "https://github.com/SantosVilanculos",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "intervention/image": "^3.11.7",
        "laravel/framework": "^12.56",
        "laravel/tinker": "^2.11.1",
        "livewire/livewire": "^3.7.15",
        "opcodesio/log-viewer": "^3.24"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.24.1",
        "laradumps/laradumps": "^4.6.2",
        "larastan/larastan": "^3.7",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.6",
        "laravel/pint": "^1.29",
        "laravel/sail": "^1.56",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^3.8.6",
        "pestphp/pest-plugin-laravel": "^3.2",
        "pestphp/pest-plugin-type-coverage": "^3.6",
        "phpstan/phpstan": "=2.1.17",
        "rector/rector": "^2.1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:models -N"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "lint": [
            "npx prettier --check \"./resources/**/*.{blade.php,css,js}\"",
            "vendor/bin/phpstan analyse",
            "vendor/bin/rector --dry-run",
            "vendor/bin/pint --test"
        ],
        "format": [
            "npx prettier --write \"./resources/**/*.{blade.php,css,js}\"",
            "vendor/bin/rector",
            "vendor/bin/pint"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "vendor/bin/pest --bail",
            "vendor/bin/pest --type-coverage --min=100"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
