{
    "arrowParens": "avoid",
    "overrides": [
        {
            "files": ["resources/views/**/*.blade.php"],
            "options": {
                "bladeDirectiveArgSpacing": "none",
                "bladeEchoSpacing": "space",
                "bladeKeepHeadAndBodyAtRoot": false,
                "parser": "blade"
            }
        }
    ],
    "plugins": ["prettier-plugin-blade"],
    "printWidth": 120,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "none"
}
